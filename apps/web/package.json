{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:embedded": "tsx scripts/start-embedded-postgres.ts",
    "db:seed-if-empty": "tsx scripts/seed-if-empty.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "excel:verify": "tsx scripts/verify-workbook.ts",
    "excel:import": "tsx scripts/import-excel.ts",
    "test": "vitest run --passWithNoTests",
    "test:api": "cross-env RUN_DB_TESTS=true vitest run src/server/api-flow.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@finance/financial-calculations": "*",
    "@finance/shared-types": "*",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
