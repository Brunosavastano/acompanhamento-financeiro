generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonRole {
  owner
  spouse
  dependent
}

enum AccountType {
  cash
  benefit
  investment
  cashback
  other
}

enum SnapshotStatus {
  draft
  closed
  revised
}

enum PositionCategory {
  cash
  benefit
  investment
  cashback
}

enum PositionSource {
  manual
  import
  adjustment
}

enum DebtSource {
  manual_matrix
  purchase
  adjustment
  import
}

enum BudgetKind {
  income
  fixed_expense
  variable_expense
}

enum BudgetRecurrence {
  monthly
  annualized
  one_off
}

enum GoalHorizon {
  short
  medium
  long
}

enum GoalOperator {
  greater_or_equal
  less_or_equal
  equals
  manual
}

enum GoalProgressStatus {
  achieved
  in_progress
  attention
  long_term
}

enum InterestRateType {
  selic_annual
}

enum DataSource {
  manual
  external_api
  import
}

enum ImportJobStatus {
  pending
  running
  completed
  failed
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id])
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Household {
  id                   String                  @id @default(cuid())
  name                 String
  baseCurrency         String                  @default("BRL")
  users                User[]
  persons              Person[]
  monthlySnapshots     MonthlySnapshot[]
  debtCashflows        DebtCashflow[]
  budgetItems          BudgetItem[]
  goals                Goal[]
  interestRates        InterestRate[]
  importJobs           ImportJob[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("households")
}

model Person {
  id             String          @id @default(cuid())
  householdId    String
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name           String
  role           PersonRole
  accounts       Account[]
  positions      Position[]
  debtCashflows  DebtCashflow[]
  budgetItems    BudgetItem[]
  createdAt      DateTime        @default(now())

  @@index([householdId])
  @@map("persons")
}

model Account {
  id          String       @id @default(cuid())
  personId    String
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  name        String
  accountType AccountType
  isActive    Boolean      @default(true)
  positions   Position[]
  createdAt   DateTime     @default(now())

  @@unique([personId, name])
  @@map("accounts")
}

model MonthlySnapshot {
  id               String          @id @default(cuid())
  householdId       String
  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  periodMonth       DateTime
  status            SnapshotStatus  @default(draft)
  selicAnnual       Decimal         @db.Decimal(12, 8)
  closedAt          DateTime?
  revisionNumber    Int             @default(1)
  revisedFromId     String?
  notes             String?
  positions         Position[]
  reconciliationRows ImportReconciliationRow[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([householdId, periodMonth, revisionNumber])
  @@index([householdId, periodMonth])
  @@map("monthly_snapshots")
}

model Position {
  id          String           @id @default(cuid())
  snapshotId  String
  snapshot    MonthlySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  personId    String
  person      Person           @relation(fields: [personId], references: [id])
  accountId   String?
  account     Account?         @relation(fields: [accountId], references: [id])
  category    PositionCategory
  amount      Decimal          @db.Decimal(18, 2)
  source      PositionSource   @default(manual)
  createdAt   DateTime         @default(now())

  @@index([snapshotId])
  @@index([personId])
  @@map("positions")
}

model DebtCashflow {
  id            String      @id @default(cuid())
  householdId    String
  household      Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  personId       String
  person         Person      @relation(fields: [personId], references: [id])
  cardName       String
  invoiceMonth   DateTime
  paymentMonth   DateTime
  amount         Decimal     @db.Decimal(18, 2)
  description    String?
  source         DebtSource  @default(manual_matrix)
  createdAt      DateTime    @default(now())

  @@index([householdId, invoiceMonth])
  @@index([householdId, paymentMonth])
  @@index([personId])
  @@map("debt_cashflows")
}

model BudgetItem {
  id            String            @id @default(cuid())
  householdId    String
  household      Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  personId       String?
  person         Person?           @relation(fields: [personId], references: [id])
  name           String
  kind           BudgetKind
  amountMonthly  Decimal           @db.Decimal(18, 2)
  recurrence     BudgetRecurrence  @default(monthly)
  startMonth     DateTime
  endMonth       DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([householdId, kind])
  @@map("budget_items")
}

model Goal {
  id                 String                 @id @default(cuid())
  householdId         String
  household           Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title              String
  horizon            GoalHorizon
  metricKey          String
  targetValueDecimal Decimal?               @db.Decimal(18, 6)
  targetValueText    String?
  targetDate         String?
  comparisonOperator GoalOperator
  riskCapValue       Decimal?               @db.Decimal(18, 6)
  manualCurrentValue String?
  notes              String?
  progressSnapshots  GoalProgressSnapshot[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([householdId, horizon])
  @@map("goals")
}

model GoalProgressSnapshot {
  id            String             @id @default(cuid())
  goalId        String
  goal          Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  periodMonth   DateTime
  currentValue  String
  progressPct   Decimal            @db.Decimal(18, 6)
  status        GoalProgressStatus

  @@unique([goalId, periodMonth])
  @@map("goal_progress_snapshots")
}

model InterestRate {
  id          String           @id @default(cuid())
  householdId String
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  periodMonth DateTime
  rateType    InterestRateType
  annualRate  Decimal          @db.Decimal(12, 8)
  source      DataSource       @default(manual)

  @@index([householdId])
  @@unique([householdId, periodMonth, rateType])
  @@map("interest_rates")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  entityType  String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ImportJob {
  id              String                    @id @default(cuid())
  householdId      String
  household        Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fileName         String
  status           ImportJobStatus           @default(pending)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  reconciliationRows ImportReconciliationRow[]
  createdAt        DateTime                  @default(now())

  @@index([householdId, status])
  @@map("import_jobs")
}

model ImportReconciliationRow {
  id              String          @id @default(cuid())
  importJobId      String
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  snapshotId       String?
  snapshot         MonthlySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  periodMonth      DateTime
  metricKey        String
  spreadsheetValue Decimal?        @db.Decimal(18, 6)
  appValue         Decimal?        @db.Decimal(18, 6)
  delta            Decimal?        @db.Decimal(18, 6)
  tolerance        Decimal         @db.Decimal(18, 6)
  passed           Boolean
  notes            String?

  @@index([importJobId, periodMonth])
  @@map("import_reconciliation_rows")
}
